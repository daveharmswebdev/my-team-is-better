# Reference data: the sqlite db is a build artifact, regenerated on every
# deploy from the committed data/raw/ JSON cache (see docs/ARCHITECTURE.md §3)
# -- never commit the derived db, but data/raw/ itself IS tracked.
packages/cfb-engine/data/*.sqlite3
packages/cfb-engine/data/*.sqlite3-*

